<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
    Name="FinAlert"
    Manufacturer="Perennis Fons"
    Version="1.0.0"
    UpgradeCode="B8C45C3D-71A0-4E6A-9D6C-2B1D58C47F13"
    Scope="perMachine"
    Platform="x64">

    <MajorUpgrade
      Schedule="afterInstallValidate"
      DowngradeErrorMessage="A newer version of FinAlert is already installed." />

    <MediaTemplate EmbedCab="yes" />

    <Icon Id="FinAlertIcon" SourceFile="assets\FinAlert.ico" />
    <Property Id="ARPPRODUCTICON" Value="FinAlertIcon" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="FinAlert">
        <Component Id="BackgroundTaskScript" Guid="*">
          <File
            Id="TaskRegistrationScript"
            Source="packaging/windows/register_background_task.ps1"
            KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="FinAlertProgramMenuFolder" Name="FinAlert" />
    </StandardDirectory>

    <DirectoryRef Id="FinAlertProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="*">
        <Shortcut
          Id="FinAlertDashboardShortcut"
          Name="FinAlert"
          Description="Open the FinAlert dashboard"
          Target="[INSTALLFOLDER]FinAlert.exe"
          WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="RemoveFinAlertProgramMenuFolder" On="uninstall" />
        <RegistryValue
          Root="HKLM"
          Key="Software\Perennis Fons\FinAlert"
          Name="installed"
          Type="integer"
          Value="1"
          KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <Feature Id="MainFeature" Title="FinAlert" Level="1">
      <Files
        Include="..\..\dist\windows\FinAlert\**"
        Directory="INSTALLFOLDER" />
      <ComponentRef Id="BackgroundTaskScript" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>

    <SetProperty
      Id="RegisterBackgroundTask"
      Value="&quot;[SystemFolder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -ExecutionPolicy Bypass -File &quot;[#TaskRegistrationScript]&quot; -InstallDirectory &quot;[INSTALLFOLDER]&quot;"
      Before="RegisterBackgroundTask"
      Sequence="execute"
      Condition="NOT Installed" />

    <SetProperty
      Id="RollbackRegisterBackgroundTask"
      Value="&quot;[SystemFolder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -ExecutionPolicy Bypass -File &quot;[#TaskRegistrationScript]&quot; -InstallDirectory &quot;[INSTALLFOLDER]&quot; -Uninstall"
      Before="RollbackRegisterBackgroundTask"
      Sequence="execute"
      Condition="NOT Installed" />

    <CustomAction
      Id="RollbackRegisterBackgroundTask"
      BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
      DllEntry="WixQuietExec"
      Execute="rollback"
      Impersonate="yes"
      Return="check" />

    <CustomAction
      Id="RegisterBackgroundTask"
      BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
      DllEntry="WixQuietExec"
      Execute="deferred"
      Impersonate="yes"
      Return="check" />

    <SetProperty
      Id="UnregisterBackgroundTask"
      Value="&quot;[SystemFolder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -ExecutionPolicy Bypass -File &quot;[#TaskRegistrationScript]&quot; -InstallDirectory &quot;[INSTALLFOLDER]&quot; -Uninstall"
      Before="UnregisterBackgroundTask"
      Sequence="execute"
      Condition="REMOVE=&quot;ALL&quot;" />

    <SetProperty
      Id="RollbackUnregisterBackgroundTask"
      Value="&quot;[SystemFolder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -ExecutionPolicy Bypass -File &quot;[#TaskRegistrationScript]&quot; -InstallDirectory &quot;[INSTALLFOLDER]&quot;"
      Before="RollbackUnregisterBackgroundTask"
      Sequence="execute"
      Condition="REMOVE=&quot;ALL&quot;" />

    <CustomAction
      Id="RollbackUnregisterBackgroundTask"
      BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
      DllEntry="WixQuietExec"
      Execute="rollback"
      Impersonate="yes"
      Return="check" />

    <CustomAction
      Id="UnregisterBackgroundTask"
      BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
      DllEntry="WixQuietExec"
      Execute="deferred"
      Impersonate="yes"
      Return="check" />

    <InstallExecuteSequence>
      <Custom
        Action="RollbackRegisterBackgroundTask"
        Before="RegisterBackgroundTask"
        Condition="NOT Installed" />
      <Custom
        Action="RegisterBackgroundTask"
        After="InstallFiles"
        Condition="NOT Installed" />
      <Custom
        Action="RollbackUnregisterBackgroundTask"
        Before="UnregisterBackgroundTask"
        Condition="REMOVE=&quot;ALL&quot;" />
      <Custom
        Action="UnregisterBackgroundTask"
        Before="RemoveFiles"
        Condition="REMOVE=&quot;ALL&quot;" />
    </InstallExecuteSequence>
  </Package>
</Wix>
